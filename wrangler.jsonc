{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appyy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "5327f8fd-1c1a-4188-a2f4-a3b17b5b6d68","database_name": "web-appt" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "c7c6350ba1404a01b49946b10b0e3b6f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
